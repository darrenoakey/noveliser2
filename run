#!/usr/bin/env python3

import argparse
import os
import subprocess
import sys
from pathlib import Path

# ##################################################################
# paths relative to this script, not cwd
SCRIPT_DIR = Path(__file__).parent.resolve()
SRC_DIR = SCRIPT_DIR / "src"
OUTPUT_DIR = SCRIPT_DIR / "output"
VENV_DIR = SCRIPT_DIR / ".venv"
if not VENV_DIR.exists():
    # Greenline's gate and development worktrees share the canonical venv.
    common = subprocess.check_output(["git", "rev-parse", "--git-common-dir"],
                                     cwd=SCRIPT_DIR, text=True).strip()
    VENV_DIR = (SCRIPT_DIR / common).resolve().parent / ".venv"


# ##################################################################
# activate venv if present
def activate_venv() -> None:
    if VENV_DIR.exists():
        venv_python = VENV_DIR / "bin" / "python"
        # Binary symlinks can be identical across unrelated venvs. Compare the
        # environment prefix, not the underlying Homebrew interpreter inode.
        if venv_python.exists() and Path(sys.prefix).resolve() != VENV_DIR.resolve():
            os.environ["VIRTUAL_ENV"] = str(VENV_DIR)
            os.execv(str(venv_python), [str(venv_python)] + sys.argv)


activate_venv()

# add src to path after venv activation
sys.path.insert(0, str(SRC_DIR))

import setproctitle

setproctitle.setproctitle("noveliser2")


# ##################################################################
# command create
# generate a new novel from a description
def command_create(args: argparse.Namespace) -> int:
    from colorama import init
    init(autoreset=True)

    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    apply_backend_options(args)

    from pipeline import write_novel
    try:
        write_novel(
            description=args.description,
            output_dir=OUTPUT_DIR,
            num_chapters=args.chapters,
            sections_per_chapter=args.sections,
            author=args.author,
            title=args.title,
            style_directive=args.style,
            cover_image=Path(args.cover).expanduser() if args.cover else None,
        )
        return 0
    except KeyboardInterrupt:
        print("\nGeneration interrupted by user")
        return 1
    except Exception as e:
        print(f"\nError during generation: {e}")
        raise


# ##################################################################
# command continue
# resume an incomplete novel generation
def command_continue(args: argparse.Namespace) -> int:
    from colorama import init
    init(autoreset=True)

    apply_backend_options(args)

    from metadata import find_book_dir_by_title
    novel_dir = find_book_dir_by_title(OUTPUT_DIR, args.title)
    if not novel_dir:
        print(f"No novel found with title: {args.title}")
        return 1

    from pipeline import write_novel
    try:
        write_novel(
            description="",
            output_dir=OUTPUT_DIR,
            continue_novel_dir=novel_dir,
        )
        return 0
    except KeyboardInterrupt:
        print("\nGeneration interrupted by user")
        return 1
    except Exception as e:
        print(f"\nError during generation: {e}")
        raise


# ##################################################################
# command list finished
# show all completed novels
def command_list_finished(_: argparse.Namespace) -> int:
    from colorama import Fore, Style, init
    init(autoreset=True)

    from metadata import list_books_by_status
    from models import BookStatus
    books = list_books_by_status(OUTPUT_DIR, BookStatus.FINISHED)
    if not books:
        print("No finished books found.")
        return 0
    for book in books:
        print(f"{Fore.GREEN}{book['title']}{Style.RESET_ALL} by {book['author']}")
        print(f"  {book['description'][:80]}")
        print(f"  EPUB: {book['epub_path']}")
        print()
    return 0


# ##################################################################
# command list ongoing
# show all in-progress novels
def command_list_ongoing(_: argparse.Namespace) -> int:
    from colorama import Fore, Style, init
    init(autoreset=True)

    from metadata import list_books_by_status
    from models import BookStatus
    books = list_books_by_status(OUTPUT_DIR, BookStatus.ONGOING)
    if not books:
        print("No ongoing books found.")
        return 0
    for book in books:
        print(f"{Fore.YELLOW}{book['title']}{Style.RESET_ALL}")
        print(f"  Step: {book['current_step'] or 'unknown'}")
        print(f"  Completed steps: {book['completed_steps']}")
        print()
    return 0


# ##################################################################
# command test
# generate a quick 1-chapter test novel
def command_test(args: argparse.Namespace) -> int:
    apply_backend_options(args)

    from colorama import init
    init(autoreset=True)

    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

    from pipeline import write_novel
    write_novel(
        description="A retired clockmaker discovers that a mysterious antique pocket watch can show glimpses of alternate timelines, but each use accelerates the entropy of the current one.",
        output_dir=OUTPUT_DIR,
        num_chapters=1,
        sections_per_chapter=1,
        author="Darren Oakey",
    )
    return 0


# ##################################################################
# command test bigger
# generate a 3-chapter test novel
def command_test_bigger(args: argparse.Namespace) -> int:
    apply_backend_options(args)

    from colorama import init
    init(autoreset=True)

    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

    from pipeline import write_novel
    write_novel(
        description="In a world where dreams are taxed by the government, a lucid dreamer discovers she can smuggle contraband ideas across the border of consciousness.",
        output_dir=OUTPUT_DIR,
        num_chapters=3,
        sections_per_chapter=2,
        author="Darren Oakey",
    )
    return 0


# ##################################################################
# command check
# run the full test suite and quality gates
def command_check(_: argparse.Namespace) -> int:
    lint = subprocess.call([sys.executable, "-m", "ruff", "check", str(SRC_DIR), str(SCRIPT_DIR / "run")])
    if lint:
        return lint
    return subprocess.call([sys.executable, "-m", "pytest", "-q", "-W", "error", "--maxfail=3", str(SRC_DIR)])


def command_deploy(_: argparse.Namespace) -> int:
    import json

    from deployment import deploy

    print(json.dumps(deploy(SCRIPT_DIR)))
    return 0


def command_health(_: argparse.Namespace) -> int:
    import json

    from deployment import health

    print(json.dumps(health(SCRIPT_DIR)))
    return 0


def command_export_book(args: argparse.Namespace) -> int:
    import json

    from audiobook import AudiobookPending
    from book_export import export_book

    try:
        report = export_book(Path(args.manuscript).expanduser().resolve(),
                             audio=args.audio, icloud=args.icloud, books=args.books,
                             config_path=Path(args.config).expanduser() if args.config else None)
    except AudiobookPending as pending:
        print(str(pending))
        print("Audio job persisted; rerun this command later to resume without resynthesis.")
        return 3
    print(json.dumps(report, indent=2))
    return 0


def add_backend_options(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--backend", choices=["sdk", "arbiter"], default=None,
                        help="Override backend (default: local/config.toml, else sdk)")
    parser.add_argument("--config", default=None, help="Explicit local TOML configuration")
    parser.add_argument("--prose-model", default=None, help="Override the configured prose model")
    parser.add_argument("--arbiter-base-url", default=None,
                        help="Override the Arbiter base URL for text generation only")
    parser.add_argument("--arbiter-high-model", default=None,
                        help="Arbiter model for high-quality text steps")
    parser.add_argument("--arbiter-low-model", default=None,
                        help="Arbiter model for fast text steps")
    # NOTE: --images / --skip-images removed. Covers and chapter images are always
    # generated — a book is not deliverable without a cover.


def apply_backend_options(args: argparse.Namespace) -> None:
    from agentd3_client import configure as configure_agentd3
    from backend import configure

    configure(backend=args.backend, arbiter_base_url=args.arbiter_base_url,
              arbiter_high_model=args.arbiter_high_model,
              arbiter_low_model=args.arbiter_low_model, config_path=args.config)
    configure_agentd3(prose_model=args.prose_model, config_path=args.config)


# ##################################################################
# main
# parse arguments and dispatch to the appropriate command
def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description="Noveliser2 - AI-powered novel generation")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_create = sub.add_parser("create", help="Generate a new novel")
    p_create.add_argument("description", help="Novel description")
    p_create.add_argument("--title", default=None, help="Force an exact title (default: LLM-generated from description)")
    p_create.add_argument("--style", default=None, help="Author's style directive (e.g. 'warm, flowing, dialogue-driven prose')")
    p_create.add_argument("--cover", default=None, help="Path to an existing image to use as the cover (skips cover generation)")
    p_create.add_argument("--chapters", type=int, default=10, help="Number of chapters (default: 10)")
    p_create.add_argument("--sections", type=int, default=10, help="Sections per chapter (default: 10)")
    p_create.add_argument("--author", default="Darren Oakey", help="Author name")
    add_backend_options(p_create)
    p_create.set_defaults(func=command_create)

    p_continue = sub.add_parser("continue", help="Resume an incomplete novel")
    p_continue.add_argument("title", help="Title of the novel to continue")
    add_backend_options(p_continue)
    p_continue.set_defaults(func=command_continue)

    p_list_finished = sub.add_parser("list-finished", help="List finished novels")
    p_list_finished.set_defaults(func=command_list_finished)

    p_list_ongoing = sub.add_parser("list-ongoing", help="List ongoing novels")
    p_list_ongoing.set_defaults(func=command_list_ongoing)

    p_test = sub.add_parser("test", help="Generate a quick 1-chapter test novel")
    add_backend_options(p_test)
    p_test.set_defaults(func=command_test)

    p_test_bigger = sub.add_parser("test_bigger", help="Generate a 3-chapter test novel")
    add_backend_options(p_test_bigger)
    p_test_bigger.set_defaults(func=command_test_bigger)

    p_export = sub.add_parser("export-book", help="Export book.json to EPUB, narration script and optional audiobook")
    p_export.add_argument("manuscript", help="Path to authoritative book.json")
    p_export.add_argument("--audio", action="store_true", help="Synthesize a resumable, chaptered M4B")
    p_export.add_argument("--icloud", action="store_true", help="Copy editions to the local iCloud Drive Books folder")
    p_export.add_argument("--books", action="store_true", help="Import EPUB/M4B into macOS Books")
    p_export.add_argument("--config", default=None, help="Path to audiobook TOML configuration")
    p_export.set_defaults(func=command_export_book)

    p_deploy = sub.add_parser("deploy", help="Install the canonical CLI and health-check it")
    p_deploy.set_defaults(func=command_deploy)
    p_health = sub.add_parser("health", help="Verify installed CLI source and rich style schema")
    p_health.set_defaults(func=command_health)

    p_check = sub.add_parser("check", help="Run tests and quality gates")
    p_check.set_defaults(func=command_check)

    args = parser.parse_args(argv)
    return args.func(args)


# ##################################################################
# standard python pattern for dispatching main
if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
